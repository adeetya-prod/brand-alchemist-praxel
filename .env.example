SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRidGhmcGhvZmdneHpodnh6ZGlmIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MDczNzU3MSwiZXhwIjoyMDk2MzEzNTcxfQ.TbxLK1eqXVAPcy7rWEBmbMoT3KaS6uyR5VXyQu7PVBc

# Database — Supabase PostgreSQL
# Settings → Database → Connection string → Transaction pooler (port 6543) for DATABASE_URL
# Session/direct (port 5432) for DIRECT_URL (used by Prisma migrations)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# OpenRouter — handles all text/chat models
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenAI direct — only needed for image generation (gpt-image-2 is not on OpenRouter)
# Leave blank to disable creative image generation
OPENAI_API_KEY=sk-...

# Cloudflare R2 Storage
# Create a bucket at https://dash.cloudflare.com and generate an API token with Object Read/Write
CF_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=brand-alchemist
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Inngest (background jobs)
# Local dev: no keys needed — run: npx inngest-cli@latest dev
# Production: get from https://app.inngest.com
INNGEST_SIGNING_KEY=signkey-prod-...
INNGEST_EVENT_KEY=...
