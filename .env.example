# Clerk Authentication
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/brands
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/brands

# Database
# Use Neon (neon.tech) or Supabase for managed PostgreSQL with connection pooling
# Append ?pgbouncer=true&connection_limit=1 for Vercel serverless
DATABASE_URL=postgresql://user:password@host:5432/brand_alchemist?pgbouncer=true&connection_limit=1

# OpenRouter — handles all text/chat models (gpt-4o for extraction, voice guide, etc.)
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI direct — only needed for image generation (gpt-image-2 is not on OpenRouter)
# Leave blank to disable creative image generation
OPENAI_API_KEY=sk-...

# Cloudflare R2 Storage
# Create a bucket at https://dash.cloudflare.com and generate an API token with Object Read/Write
CF_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=brand-alchemist
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# Public URL prefix exposed to the browser (same value as R2_PUBLIC_URL, must be NEXT_PUBLIC_)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Inngest (background jobs)
# Get from https://app.inngest.com after creating an app
INNGEST_SIGNING_KEY=signkey-prod-...
INNGEST_EVENT_KEY=...
